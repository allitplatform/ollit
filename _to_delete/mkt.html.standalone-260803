<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#0A0A0A">
<link rel="manifest" href="/mkt-manifest.json">
<link rel="apple-touch-icon" href="/icon-ads-180.png">
<title>올잇 마케팅</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; }
  :root { --bg:#0A0A0A; --card:#161616; --inset:#1E1E1E; --ink:#F5F5F5; --ink2:#B9BDC4; --mut:#7d8590;
    --line:#262626; --accent:#FF1B8D; --blue:#3987e5; --good:#22C55E; --warn:#F59E0B; --bad:#EF4444; }
  body { font-family:'Pretendard',system-ui,-apple-system,'Segoe UI',sans-serif; background:var(--bg); color:var(--ink);
    min-height:100vh; padding:env(safe-area-inset-top) 0 0; }
  .wrap { max-width:480px; margin:0 auto; padding:0 16px 48px; }

  /* ── 로그인 ── */
  #login { display:flex; flex-direction:column; align-items:center; justify-content:center; min-height:92vh; text-align:center; }
  .logo { width:110px; height:64px; margin-bottom:34px; }
  .brand { font-size:42px; font-weight:900; letter-spacing:-1px; }
  .brand small { display:block; font-size:13px; color:var(--ink2); font-weight:600; letter-spacing:0; margin-top:10px; }
  .lbox { width:100%; max-width:400px; margin-top:44px; }
  .lbox input { width:100%; padding:18px 20px; border-radius:16px; border:1px solid var(--line); background:var(--inset);
    color:var(--ink); font-size:16px; font-weight:600; font-family:inherit; outline:none; margin-bottom:14px; }
  .lbox input::placeholder { color:var(--mut); }
  .lbox button { width:100%; padding:18px 0; border-radius:16px; border:none; background:var(--accent); color:#fff;
    font-size:17px; font-weight:800; cursor:pointer; font-family:inherit; }
  .lerr { min-height:20px; font-size:12px; color:var(--bad); font-weight:700; margin-top:12px; }
  .lver { margin-top:26px; font-size:11px; color:var(--mut); font-weight:600; }

  /* ── 관제판 ── */
  #app { display:none; padding-top:14px; }
  header { display:flex; align-items:center; gap:8px; margin-bottom:2px; }
  h1 { font-size:19px; font-weight:900; letter-spacing:-.3px; }
  .by { font-size:9.5px; color:var(--mut); font-weight:700; letter-spacing:1.5px; }
  #logout { margin-left:auto; background:transparent; border:1px solid var(--line); color:var(--mut); font-size:11px;
    font-weight:700; border-radius:8px; padding:5px 10px; cursor:pointer; font-family:inherit; }
  .sub { font-size:11px; color:var(--mut); font-weight:600; margin-bottom:13px; }
  .adv { display:flex; gap:6px; margin-bottom:12px; }
  .adv button { flex:1; padding:11px 0; border-radius:12px; border:1px solid var(--line); background:var(--card); color:var(--ink2); font-size:13px; font-weight:800; cursor:pointer; font-family:inherit; }
  .adv button.on { background:var(--accent); border-color:var(--accent); color:#fff; }
  .tabs { display:flex; gap:6px; margin-bottom:12px; }
  .tabs button { flex:1; padding:8px 0; border-radius:10px; border:1px solid var(--line); background:transparent; color:var(--ink2); font-size:12px; font-weight:700; cursor:pointer; font-family:inherit; }
  .tabs button.on { background:rgba(255,27,141,.12); border-color:var(--accent); color:var(--accent); }
  .card { background:var(--card); border:1px solid var(--line); border-radius:16px; padding:15px 16px 13px; margin-bottom:12px; }
  .card h2 { font-size:13px; font-weight:800; margin-bottom:10px; }
  .hero { display:flex; align-items:center; gap:8px; margin-bottom:10px; }
  .hero .num { font-size:27px; font-weight:900; }
  .hero .unit { font-size:13px; color:var(--mut); font-weight:700; }
  .chip { margin-left:auto; font-size:11px; font-weight:800; border-radius:999px; padding:4px 11px; background:rgba(255,255,255,.06); }
  .tiles { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
  .tile { background:var(--inset); border-radius:10px; padding:10px 8px; text-align:center; }
  .tile .l { font-size:9.5px; color:var(--mut); font-weight:700; margin-bottom:3px; }
  .tile .v { font-size:15px; font-weight:800; }
  .rows .row { display:flex; align-items:center; gap:8px; padding:7px 0; border-top:1px solid var(--line); font-size:12px; }
  .rows .row:first-child { border-top:none; }
  .row .name { flex:1; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .row .m { color:var(--ink2); font-variant-numeric:tabular-nums; }
  .patrol { margin-top:10px; padding-top:8px; border-top:1px solid var(--line); font-size:10.5px; font-weight:700; color:var(--mut); }
  .patrol.alert { color:var(--bad); }
  .empty { padding:14px; text-align:center; color:var(--mut); font-size:12px; font-weight:600; }
  .note { font-size:10px; color:var(--mut); font-weight:600; line-height:1.7; padding:2px 2px 0; }
  .linkbtn { display:block; text-align:center; padding:14px 0; border-radius:13px; background:var(--accent); color:#fff; font-size:13.5px; font-weight:800; text-decoration:none; }
  footer { text-align:center; font-size:10px; color:var(--mut); font-weight:700; margin-top:18px; }
</style>
</head>
<body>

<!-- 로그인 -->
<div id="login">
  <svg class="logo" viewBox="0 0 220 128" fill="none">
    <circle cx="64" cy="64" r="54" stroke="#FF1B8D" stroke-width="9"/>
    <circle cx="156" cy="64" r="54" stroke="#FF1B8D" stroke-width="9"/>
    <circle cx="110" cy="64" r="30" fill="#D6338A" opacity="0.85"/>
  </svg>
  <div class="brand">올잇 마케팅<small>광고주 성과를 잇는 관제판</small></div>
  <div class="lbox">
    <input id="pw" type="password" placeholder="비밀번호" autocomplete="current-password">
    <button id="loginBtn">로그인</button>
    <div class="lerr" id="lerr"></div>
  </div>
  <div class="lver">v1.0 · ALLIT MARKETING</div>
</div>

<!-- 관제판 -->
<div id="app">
<div class="wrap">
  <header><h1>광고주 관제판</h1><span class="by">ALLIT MARKETING</span><button id="logout">로그아웃</button></header>
  <div class="sub" id="range">-</div>

  <div class="adv" id="adv">
    <button data-a="yusol" class="on">유솔홈케어</button>
    <button data-a="allday">올데이케어</button>
  </div>

  <div id="v-yusol">
    <div class="tabs" id="tabs">
      <button data-p="today">오늘</button>
      <button data-p="week" class="on">최근 7일</button>
      <button data-p="month">이번 달</button>
    </div>
    <div class="card">
      <div class="hero">
        <span class="num" id="per">-</span><span class="unit">원/주문</span>
        <span class="chip" id="verdict" style="color:#94a3b8">집계중</span>
      </div>
      <div class="tiles">
        <div class="tile"><div class="l">광고비(VAT포함)</div><div class="v" id="cost">-</div></div>
        <div class="tile"><div class="l">클릭</div><div class="v" id="clicks">-</div></div>
        <div class="tile"><div class="l">주문(전환)</div><div class="v" id="conv">-</div></div>
      </div>
      <div class="patrol" id="patrol">🛡 클릭 감시 준비 중</div>
      <div class="note">판정: 주문당 5,000원 이하 효율 · 10,000원 이하 적정 · 초과 조정 (벽걸이 마진 1.8만 기준)</div>
    </div>
    <div class="card"><h2>캠페인별</h2><div class="rows" id="camps"><div class="empty">-</div></div></div>
    <div class="card"><h2>일별 흐름</h2><div class="rows" id="days"><div class="empty">-</div></div></div>
  </div>

  <div id="v-allday" style="display:none">
    <div class="card">
      <h2>올데이케어 광고 관제판</h2>
      <div class="note" style="margin-bottom:12px">올데이케어는 기존 관제판(실시간 키워드·순위·자동입찰)을 사용합니다.</div>
      <a class="linkbtn" href="/ads-console.html">관제판 열기 →</a>
    </div>
  </div>

  <footer>올잇 마케팅 · 홈 화면에 추가하면 앱처럼 쓸 수 있습니다</footer>
</div>
</div>

<script>
(function(){
  // 접근: 비밀번호 → 읽기 토큰. 비밀번호 변경은 이 두 값 수정.
  var PW = "allit2026";
  var TOKEN = "yz74c1e0a95d2b8f36e41c07";

  var loginEl = document.getElementById("login"), appEl = document.getElementById("app");
  function showApp(){ loginEl.style.display="none"; appEl.style.display="block"; loadYusol(); }
  function tryLogin(){
    var v = document.getElementById("pw").value.trim();
    if (v === PW) {
      try { localStorage.setItem("mkt_auth", "1"); } catch(e){}
      showApp();
    } else {
      document.getElementById("lerr").textContent = "비밀번호가 맞지 않습니다";
    }
  }
  document.getElementById("loginBtn").addEventListener("click", tryLogin);
  document.getElementById("pw").addEventListener("keydown", function(e){ if(e.key==="Enter") tryLogin(); });
  document.getElementById("logout").addEventListener("click", function(){
    try { localStorage.removeItem("mkt_auth"); } catch(e){}
    location.reload();
  });

  var period = "week";
  function kstDate(off){ var d=new Date(Date.now()+9*3600*1000); d.setUTCDate(d.getUTCDate()+(off||0)); return d.toISOString().slice(0,10); }
  function range(){
    var today=kstDate(0);
    if(period==="today") return {s:today,u:today};
    if(period==="week")  return {s:kstDate(-6),u:today};
    return {s:today.slice(0,8)+"01",u:today};
  }
  function won(n){ return Number(n||0).toLocaleString("ko-KR"); }

  function loadYusol(){
    var r=range();
    document.getElementById("range").textContent = (r.s===r.u? r.s+" (하루)" : r.s+" ~ "+r.u) + " · KST";
    fetch("/api/yusol-ad?token="+TOKEN+"&since="+r.s+"&until="+r.u+"&daily=1",{cache:"no-store"})
      .then(function(x){return x.json();})
      .then(function(j){
        if(!j||j.ok===false){ document.getElementById("range").textContent="연결 대기 — "+String(j&&j.error||""); return; }
        var costVat=Math.round((j.cost||0)*1.1), conv=j.conv||0;
        var per=conv>0?Math.round(costVat/conv):null;
        document.getElementById("cost").textContent=won(costVat)+"원";
        document.getElementById("clicks").textContent=won(j.clicks||0);
        document.getElementById("conv").textContent=won(conv);
        document.getElementById("per").textContent=per!=null?won(per):"-";
        var v,c;
        if(per!=null&&per<=5000){v="효율 좋음";c="var(--good)";}
        else if(per!=null&&per<=10000){v="적정";c="var(--warn)";}
        else if(per!=null){v="조정 필요";c="var(--bad)";}
        else if(costVat>0){v="주문 집계 전";c="var(--warn)";}
        else{v="라이브 대기";c="#94a3b8";}
        var chip=document.getElementById("verdict"); chip.textContent=v; chip.style.color=c;
        var camps=(j.campaigns||[]).slice().sort(function(a,b){return (b.cost||0)-(a.cost||0);});
        document.getElementById("camps").innerHTML = camps.length? camps.map(function(x){
          return '<div class="row"><span class="name">'+String(x.name||"").replace(/</g,"&lt;")+'</span>'
            +'<span class="m">'+won(Math.round((x.cost||0)*1.1))+'원</span><span class="m">'+won(x.clicks||0)+'클릭</span>'
            +'<span class="m" style="font-weight:800">'+won(x.conv||0)+'주문</span></div>';
        }).join("") : '<div class="empty">캠페인 준비 중</div>';
        var days=(j.days||[]).slice().reverse();
        document.getElementById("days").innerHTML = days.length? days.map(function(d){
          return '<div class="row"><span class="name">'+d.ymd.slice(5)+'</span>'
            +'<span class="m">'+won(Math.round((d.cost||0)*1.1))+'원</span><span class="m">'+won(d.clicks||0)+'클릭</span>'
            +'<span class="m" style="font-weight:800">'+won(d.conv||0)+'주문</span></div>';
        }).join("") : '<div class="empty">아직 집계된 날이 없습니다</div>';
      })
      .catch(function(){ document.getElementById("range").textContent="일시적 오류 — 잠시 후 새로고침"; });

    fetch("/api/yusol-ad?token="+TOKEN+"&since="+kstDate(-7)+"&until="+kstDate(0)+"&daily=1",{cache:"no-store"})
      .then(function(x){return x.json();})
      .then(function(j){
        if(!j||j.ok===false||!j.days) return;
        var today=kstDate(0), t=null, prev=[];
        j.days.forEach(function(d){ if(d.ymd===today) t=d; else prev.push(d); });
        var avg=prev.length? prev.reduce(function(a,d){return a+d.clicks;},0)/prev.length : 0;
        var tc=t?t.clicks:0, ratio=avg>0? tc/avg : null;
        var el=document.getElementById("patrol");
        if(ratio!=null && ratio>=2.5 && tc>=20){
          el.className="patrol alert";
          el.textContent="⚠ 클릭 급증 의심 — 오늘 "+tc+"클릭 (직전7일 평균 "+Math.round(avg)+"의 "+ratio.toFixed(1)+"배). 노출제한 IP 점검";
        } else {
          el.className="patrol";
          el.textContent="🛡 클릭 감시 정상 — 오늘 "+tc+" · 직전7일 평균 "+Math.round(avg);
        }
      }).catch(function(){});
  }

  document.getElementById("tabs").addEventListener("click",function(e){
    var b=e.target.closest("button"); if(!b) return;
    period=b.dataset.p;
    document.querySelectorAll("#tabs button").forEach(function(x){x.classList.toggle("on",x===b);});
    loadYusol();
  });
  document.getElementById("adv").addEventListener("click",function(e){
    var b=e.target.closest("button"); if(!b) return;
    var a=b.dataset.a;
    document.querySelectorAll("#adv button").forEach(function(x){x.classList.toggle("on",x===b);});
    document.getElementById("v-yusol").style.display = a==="yusol" ? "" : "none";
    document.getElementById("v-allday").style.display = a==="allday" ? "" : "none";
  });

  var authed = false;
  try { authed = localStorage.getItem("mkt_auth") === "1"; } catch(e){}
  if (authed) showApp();
  setInterval(function(){ if (appEl.style.display === "block") loadYusol(); }, 5*60*1000);
})();
</script>
</body>
</html>
