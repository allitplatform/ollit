[E] 백필 SQL 초안 (실행 전 검토용, BEGIN/COMMIT 분리 실행 권장)
──────────────────────────────────────────────────────────────────────────────────────────────────────────────

-- ============================================
-- usol_n 정산 이중곱 백필 — 13행 unit_price 정정
-- 작성일 : 2026-05-27
-- 배경   : CSV "정산예정금액"이 수량 합계로 들어와 unit_price에 박힘 → GENERATED subtotal=qty×unit_price 이중곱.
--          파서는 f491158에서 동적 판정으로 정상화. 본 SQL은 이미 저장된 13행 정정.
-- 안전   :
--   · status='완료' 0건 → compute_payment 미발동 / payments row 0건
--   · subtotal은 GENERATED COLUMN(자동 재계산)
--   · tasks.product_price는 task_items_resync_task_total_trg(Mig 070)가 자동 정정
-- ============================================

-- [0] 사전 검증 SELECT — 정정 대상 13행 현재값 확인
SELECT ti.id, t.task_no, ti.qty, ti.unit_price, ti.subtotal, ti.customer_paid_amount
FROM task_items ti
JOIN tasks t ON t.id = ti.task_id
WHERE ti.id IN (
  '95e43e8d-2cc6-4ca8-9c9b-50c925cf8e75',
  'ce300b28-5a3d-4d02-82a2-78dad3ba31de',
  'f616c496-20d5-4b22-a302-fde24fe695b7',
  '0c1ff21f-404b-4ffa-a935-db7dc3dc925b',
  '3859920d-d189-4f9a-bc1d-69a14424568d',
  'cd16f3ec-ced5-4a63-b8a6-0d01e73da36d',
  '2c0575d2-1218-4ca8-813e-9a1ad04df08a',
  '3d01b9f3-69e9-4d4f-a656-7e03fc8d48ab',
  '0925d91e-0545-420b-975a-f74d1b83d4b1',
  '94511f15-2d57-43f3-89fe-0d11a8c0e493',
  '2059b9c4-6b64-4711-b96d-03729a39c722',
  'badb2463-f001-42fb-810c-796e6282a967',
  '53adf184-b6fd-45b8-8a10-06376490f2c1'
) ORDER BY t.task_no;

-- [1] 백필 UPDATE — 13행 unit_price = ROUND(unit_price / qty)
BEGIN;

UPDATE task_items SET unit_price = 89999 WHERE id = '95e43e8d-2cc6-4ca8-9c9b-50c925cf8e75'; -- YS-N-260525-007 qty=5 (449993 → 89999)
UPDATE task_items SET unit_price = 73132 WHERE id = 'ce300b28-5a3d-4d02-82a2-78dad3ba31de'; -- YS-N-260525-030 qty=3 (219395 → 73132)
UPDATE task_items SET unit_price = 63368 WHERE id = 'f616c496-20d5-4b22-a302-fde24fe695b7'; -- YS-N-260525-032 qty=2 (126735 → 63368)
UPDATE task_items SET unit_price = 9444 WHERE id = '0c1ff21f-404b-4ffa-a935-db7dc3dc925b'; -- YS-N-260525-041 qty=2 (18888 → 9444)
UPDATE task_items SET unit_price = 9444 WHERE id = '3859920d-d189-4f9a-bc1d-69a14424568d'; -- YS-N-260525-045 qty=3 (28332 → 9444)
UPDATE task_items SET unit_price = 70120 WHERE id = 'cd16f3ec-ced5-4a63-b8a6-0d01e73da36d'; -- YS-N-260525-045 qty=2 (140240 → 70120)
UPDATE task_items SET unit_price = 70120 WHERE id = '2c0575d2-1218-4ca8-813e-9a1ad04df08a'; -- YS-N-260526-005 qty=2 (140239 → 70120)
UPDATE task_items SET unit_price = 70120 WHERE id = '3d01b9f3-69e9-4d4f-a656-7e03fc8d48ab'; -- YS-N-260526-004 qty=2 (140239 → 70120)
UPDATE task_items SET unit_price = 89007 WHERE id = '0925d91e-0545-420b-975a-f74d1b83d4b1'; -- YS-N-260526-008 qty=2 (178014 → 89007)
UPDATE task_items SET unit_price = 89007 WHERE id = '94511f15-2d57-43f3-89fe-0d11a8c0e493'; -- YS-N-260526-013 qty=2 (178014 → 89007)
UPDATE task_items SET unit_price = 71772 WHERE id = '2059b9c4-6b64-4711-b96d-03729a39c722'; -- YS-N-260526-014 qty=5 (358861 → 71772)
UPDATE task_items SET unit_price = 70120 WHERE id = 'badb2463-f001-42fb-810c-796e6282a967'; -- YS-N-260526-027 qty=2 (140239 → 70120)
UPDATE task_items SET unit_price = 90660 WHERE id = '53adf184-b6fd-45b8-8a10-06376490f2c1'; -- YS-N-260526-039 qty=3 (271979 → 90660)

COMMIT;

-- [2] 사후 검증 — 13행 subtotal/product_price 정정 확인
SELECT ti.id, t.task_no, t.product_price AS task_pp, ti.qty, ti.unit_price, ti.subtotal
FROM task_items ti
JOIN tasks t ON t.id = ti.task_id
WHERE ti.id IN (
  '95e43e8d-2cc6-4ca8-9c9b-50c925cf8e75',
  'ce300b28-5a3d-4d02-82a2-78dad3ba31de',
  'f616c496-20d5-4b22-a302-fde24fe695b7',
  '0c1ff21f-404b-4ffa-a935-db7dc3dc925b',
  '3859920d-d189-4f9a-bc1d-69a14424568d',
  'cd16f3ec-ced5-4a63-b8a6-0d01e73da36d',
  '2c0575d2-1218-4ca8-813e-9a1ad04df08a',
  '3d01b9f3-69e9-4d4f-a656-7e03fc8d48ab',
  '0925d91e-0545-420b-975a-f74d1b83d4b1',
  '94511f15-2d57-43f3-89fe-0d11a8c0e493',
  '2059b9c4-6b64-4711-b96d-03729a39c722',
  'badb2463-f001-42fb-810c-796e6282a967',
  '53adf184-b6fd-45b8-8a10-06376490f2c1'
) ORDER BY t.task_no;

