# Step 6-1 (1단계) — PWA 푸시 알림 환경 변수 placeholder
# 실제 값은 .env.local에 박음 (.gitignore로 보호 / 절대 커밋 X)

# 클라이언트 (브라우저) 측 — VITE_ 접두 필수
VITE_VAPID_PUBLIC=your_vapid_public_key_here

# 서버 (Vercel API) 측 — Vercel 환경 변수에만 박음 (Sensitive)
# VAPID_PRIVATE=your_vapid_private_key_here
# VAPID_SUBJECT=mailto:admin@allday-care.com
